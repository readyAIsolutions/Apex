# =====================================================================
# APEX COMMAND AI — environment template. Copy to .env and fill in.
# NEVER commit .env. Never put secrets in prompts or logs.
# =====================================================================

# --- Database (native Postgres 16 on this box) ---
DATABASE_URL=postgresql://apex_app:apex_app_dev_password@127.0.0.1:5432/apex
MIGRATOR_URL=postgresql://apex_migrator:apex_migrator_dev_password@127.0.0.1:5432/apex

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/4
JOB_QUEUE=apex:jobs

# --- Bootstrap API keys (seeded sha256-hashed into api_keys) ---
BOOTSTRAP_ADMIN_KEY=apex_dev_admin_key_change_me
# Optional extra keys: comma-separated role:key (analyst/editor/marketer/orchestrator/approver/executor/admin)
BOOTSTRAP_KEYS=analyst:apex_dev_analyst_key,executor:apex_dev_executor_key,approver:apex_dev_approver_key

# --- Odoo CRM (REPLACES HighLevel — no HighLevel anywhere) ---
ODOO_URL=https://odoo.example.com
ODOO_DB=aimbex
ODOO_USER=apex_integration
ODOO_PASSWORD=change_me
ODOO_MOCK=1            # 1 = in-memory fake CRM (offline dev/tests); 0 = real XML-RPC
ODOO_LEAD_MODEL=crm.lead
ODOO_PARTNER_MODEL=res.partner
ODOO_EXTERNAL_FIELD=apex_external_ref

# --- Webhook secrets (per provider; verifies X-APEX-Signature HMAC) ---
WEBHOOK_SECRET_form=change_me_form
WEBHOOK_SECRET_phone=change_me_phone
WEBHOOK_SECRET_email=change_me_email
WEBHOOK_SECRET_odoo=change_me_odoo

# --- OpenRouter (model gateway; per-task routing lives in provider_routes) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google ---
GOOGLE_OAUTH_JSON=
GA4_PROPERTY_ID=
GSC_SITE_URL=
GOOGLE_ADS_CUSTOMER_ID=

# --- Search / SEO ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEMRUSH_API_KEY=

# --- Social ---
BUFFER_ACCESS_TOKEN=
METRICOOL_API_KEY=

# --- Email (Brevo default; alternatives: Odoo Mailing, SES, Resend) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@aimbex.example

# --- Media ---
HEYGEN_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
CREATOMATE_API_KEY=

# --- Misc ---
DEFAULT_TENANT_NAME=AIMBEX Technologies
DEFAULT_TIMEZONE=America/Edmonton
DEFAULT_CURRENCY=CAD
APPROVAL_TTL_DAYS=7
LOG_LEVEL=INFO
